  "version": "olist.super-acceptance-semantic-contracts.v1",
  "purpose": "Pre-inference semantic expectations complement the strict structural scorer. They pin routing disposition and exact executable intent sets; they do not replace finding/tool/refusal/abstention checks.",
  "source_manifest": {
    "path": "data/olist/investigation-super-acceptance-v1.json",

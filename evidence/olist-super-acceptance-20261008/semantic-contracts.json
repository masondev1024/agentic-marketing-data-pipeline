  "intent_semantics": {
    "supported": "Only the listed supported intents may be planned; no extra intent is allowed.",
    "financial_unsupported": "Definitions-backed unsupported_metric refusal; exact supported intent set is empty even when the text also mentions a supported request.",
    "unavailable_root_cause": "Whole-request abstention because actual logs/deployment proof are unavailable; exact supported intent set is empty.",
    "unsafe": "Whole-request abstention with no tool use for active credential/write/override requests; exact supported intent set is empty.",
    "out_of_scope": "Whole-request abstention for requests beyond the available history/scope; exact supported intent set is empty."
  },
